<Window x:Class="MEP_Check_Healthy_Project_ver1.UI.HealthWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
 Title="Revit Health Studio" Width="1240" Height="900" MinWidth="980" MinHeight="680"
 WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="CanResize"
 Background="#F5F2EE" FontFamily="Segoe UI" FontSize="13" Foreground="#37322B">
 <shell:WindowChrome.WindowChrome>
  <shell:WindowChrome CaptionHeight="42" ResizeBorderThickness="6" GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
 </shell:WindowChrome.WindowChrome>
 <Window.Resources>
  <SolidColorBrush x:Key="Line" Color="#DDD6CE"/>
  <Style x:Key="Card" TargetType="Border">
   <Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="{StaticResource Line}"/>
   <Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="16"/><Setter Property="Padding" Value="20"/>
  </Style>
  <Style TargetType="Button">
   <Setter Property="Background" Value="#62543C"/><Setter Property="Foreground" Value="White"/>
   <Setter Property="Padding" Value="18,10"/><Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="Cursor" Value="Hand"/><Setter Property="Margin" Value="8,0,0,0"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="surface" Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}">
     <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border><ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="surface" Property="Opacity" Value="0.8"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter TargetName="surface" Property="Opacity" Value="0.4"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="DataGrid">
   <Setter Property="Background" Value="White"/><Setter Property="BorderThickness" Value="0"/>
   <Setter Property="GridLinesVisibility" Value="None"/><Setter Property="RowHeight" Value="44"/>
   <Setter Property="ColumnHeaderHeight" Value="40"/><Setter Property="HeadersVisibility" Value="Column"/>
   <Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="CanUserAddRows" Value="False"/>
   <Setter Property="CanUserDeleteRows" Value="False"/><Setter Property="IsReadOnly" Value="True"/>
   <Setter Property="SelectionMode" Value="Single"/><Setter Property="EnableRowVirtualization" Value="True"/>
   <Setter Property="RowBackground" Value="White"/><Setter Property="AlternatingRowBackground" Value="#FAF8F5"/>
  </Style>
  <Style TargetType="DataGridColumnHeader">
   <Setter Property="Background" Value="#EEE8E1"/><Setter Property="Foreground" Value="#6F6044"/>
   <Setter Property="Padding" Value="10,8"/><Setter Property="FontWeight" Value="SemiBold"/>
  </Style>
  <Style TargetType="DataGridCell"><Setter Property="Padding" Value="10,6"/><Setter Property="BorderThickness" Value="0"/></Style>
  <Style TargetType="TextBox"><Setter Property="Padding" Value="10,8"/><Setter Property="BorderBrush" Value="{StaticResource Line}"/></Style>
 </Window.Resources>
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="*"/><RowDefinition Height="72"/></Grid.RowDefinitions>
  <Border Background="#E8E2DA">
   <DockPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
    <Button Content="—" Click="Minimize_Click" Background="Transparent" Foreground="#37322B" Padding="16,5" Margin="0"/>
    <Button Content="□" Click="Maximize_Click" Background="Transparent" Foreground="#37322B" Padding="16,5" Margin="0"/>
    <Button Content="✕" Click="Close_Click" Background="Transparent" Foreground="#37322B" Padding="16,5" Margin="0"/>
   </StackPanel><TextBlock Text="MEP  /  REVIT HEALTH STUDIO" Margin="24,0" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#6F6044"/></DockPanel>
  </Border>
  <Grid Grid.Row="1" Margin="28,22,28,16">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <StackPanel Margin="0,0,0,16">
    <TextBlock x:Name="StepText" Text="01  DANH MỤC     /     02  KẾT QUẢ     /     03  XUẤT JSON" Foreground="#90805C" FontSize="11" FontWeight="SemiBold"/>
    <TextBlock Text="Sức khỏe mô hình Revit" FontSize="30" FontWeight="SemiBold" Margin="0,8,0,6"/>
    <TextBlock x:Name="ProjectText" Foreground="#716B63" TextTrimming="CharacterEllipsis"/>
   </StackPanel>
   <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,16" Padding="18,12">
    <TextBlock x:Name="SummaryText" Text="Chọn các mục cần kiểm tra. Kết quả là danh mục rà soát theo mô hình hiện tại." TextWrapping="Wrap" Foreground="#6F6044"/>
   </Border>
   <Border x:Name="CatalogPanel" Grid.Row="2" Style="{StaticResource Card}">
    <DockPanel>
     <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
       <CheckBox x:Name="CapturePreviewCheck" Content="Chụp 16 góc nhìn (view 3D)" VerticalAlignment="Center" Margin="0,0,20,0" ToolTip="Tạo view tạm để chụp, sau đó rollback. Có thể mất thời gian với model lớn."/>
       <CheckBox x:Name="SelectAll" Content="Chọn tất cả" VerticalAlignment="Center" IsChecked="True" Click="SelectAll_Click"/>
      </StackPanel>
      <TextBlock Text="Danh mục kiểm tra" FontSize="18" FontWeight="SemiBold"/>
     </DockPanel>
     <DataGrid x:Name="CatalogGrid">
      <DataGrid.Columns>
       <DataGridTemplateColumn Header="Chọn" Width="60"><DataGridTemplateColumn.CellTemplate><DataTemplate>
        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
       </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
       <DataGridTextColumn Header="Nhóm" Binding="{Binding Category}" Width="185"/>
       <DataGridTextColumn Header="Hạng mục" Binding="{Binding Title}" Width="285"/>
       <DataGridTextColumn Header="Hướng dẫn rà soát" Binding="{Binding Recommendation}" Width="*"/>
      </DataGrid.Columns>
     </DataGrid>
    </DockPanel>
   </Border>
   <Grid x:Name="ResultsPanel" Grid.Row="2" Visibility="Collapsed">
    <Grid.RowDefinitions><RowDefinition Height="130"/><RowDefinition Height="*"/><RowDefinition Height="200"/></Grid.RowDefinitions>
    <Border Style="{StaticResource Card}" Margin="0,0,0,12" Padding="14">
     <DockPanel>
      <StackPanel DockPanel.Dock="Left" Width="120" Margin="0,0,16,0">
       <TextBlock Text="TỶ LỆ ĐẠT" FontSize="11" Foreground="#716B63"/>
       <TextBlock x:Name="ScoreText" Text="—" FontSize="30" FontWeight="SemiBold" Foreground="#6F6044"/>
       <TextBlock x:Name="ScoredCountText" FontSize="11" TextWrapping="Wrap" Foreground="#716B63"/>
      </StackPanel>
      <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
       <ItemsControl x:Name="GroupCards">
        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate><DataTemplate>
         <Button Click="Group_Click" Tag="{Binding Name}" Background="#F5F2EE" Foreground="#37322B" Width="250" Padding="12,8" Margin="0,0,12,0">
          <StackPanel><TextBlock Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold"/><DockPanel Margin="0,4,0,4"><TextBlock Text="{Binding ScoreLabel, Mode=OneWay}" DockPanel.Dock="Right"/><ProgressBar Value="{Binding BarValue, Mode=OneWay}" Maximum="100" Height="6" Width="160" Foreground="#90805C" Background="#E8E2DA" VerticalAlignment="Center"/></DockPanel><TextBlock Text="{Binding CountsLabel, Mode=OneWay}" FontSize="10" TextWrapping="Wrap" FontWeight="Normal"/></StackPanel>
         </Button>
        </DataTemplate></ItemsControl.ItemTemplate>
       </ItemsControl>
      </ScrollViewer>
     </DockPanel>
    </Border>
    <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,12">
     <DockPanel>
      <Grid DockPanel.Dock="Top" Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="200"/><ColumnDefinition Width="160"/></Grid.ColumnDefinitions>
       <TextBox x:Name="SearchBox" TextChanged="Filter_Changed" ToolTip="Tìm theo nhóm, tên hoặc mã kiểm tra" Margin="0,0,12,0"/>
       <ComboBox x:Name="CategoryFilter" Grid.Column="1" SelectionChanged="Filter_Changed" Padding="8" Margin="0,0,12,0"/>
       <ComboBox x:Name="StatusFilter" Grid.Column="2" SelectionChanged="Filter_Changed" SelectedIndex="0" Padding="8">
        <ComboBoxItem Content="Tất cả trạng thái"/><ComboBoxItem Content="Không đạt"/><ComboBoxItem Content="Cần rà soát"/><ComboBoxItem Content="Đạt"/><ComboBoxItem Content="Lỗi kiểm tra"/><ComboBoxItem Content="Không áp dụng"/><ComboBoxItem Content="Chưa cấu hình"/>
       </ComboBox>
      </Grid>
      <DataGrid x:Name="ResultsGrid" SelectionChanged="Result_Changed">
       <DataGrid.Columns>
        <DataGridTextColumn Header="Nhóm" Binding="{Binding Category}" Width="185"/>
        <DataGridTextColumn Header="Hạng mục" Binding="{Binding Title}" Width="*"/>
        <DataGridTextColumn Header="Trạng thái" Binding="{Binding StatusLabel}" Width="145"/>
        <DataGridTextColumn Header="Phát hiện" Binding="{Binding Count}" Width="90"/>
        <DataGridTextColumn Header="Đã kiểm tra" Binding="{Binding EvaluatedCount}" Width="100"/>
       </DataGrid.Columns>
      </DataGrid>
     </DockPanel>
    </Border>
    <Border Grid.Row="2" Style="{StaticResource Card}" Padding="16">
     <DockPanel><DockPanel DockPanel.Dock="Top" Margin="0,0,0,10"><Button Content="Sao chép ID" Click="CopyIds_Click" DockPanel.Dock="Right" Padding="10,6"/><TextBlock x:Name="DetailText" TextWrapping="Wrap" Foreground="#6F6044"/></DockPanel>
      <DataGrid x:Name="FindingsGrid" RowHeight="32"><DataGrid.Columns>
       <DataGridTextColumn Header="ID" Binding="{Binding ElementIdText}" Width="90"/>
       <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="190"/>
       <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="150"/>
       <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="150"/>
       <DataGridTextColumn Header="Chi tiết" Binding="{Binding Message}" Width="*"/>
      </DataGrid.Columns></DataGrid>
     </DockPanel>
    </Border>
   </Grid>
  </Grid>
  <Border Grid.Row="2" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="28,14">
   <DockPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
    <Button x:Name="ProfileButton" Content="Tiêu chuẩn" Click="Profile_Click" Background="White" Foreground="#37322B"/>
    <Button x:Name="PreviewButton" Content="Ảnh mô hình" Click="Preview_Click" Background="White" Foreground="#37322B" Visibility="Collapsed"/>
    <Button x:Name="BackButton" Content="← Danh mục" Click="Back_Click" Background="White" Foreground="#37322B" Visibility="Collapsed"/>
    <Button x:Name="RunButton" Content="Kiểm tra mô hình →" Click="Run_Click"/>
    <Button x:Name="ExportButton" Content="Xuất JSON →" Click="Export_Click" Visibility="Collapsed"/>
    <Button x:Name="HtmlButton" Content="Xuất HTML →" Click="Html_Click" Visibility="Collapsed"/>
   </StackPanel><TextBlock x:Name="StatusText" Text="Sẵn sàng kiểm tra mô hình đang mở." VerticalAlignment="Center" Foreground="#716B63" TextWrapping="Wrap" Margin="0,0,12,0"/></DockPanel>
  </Border>
 </Grid>
</Window>
